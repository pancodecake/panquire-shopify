{% doc %}
  Small functional interface icons.
  @param {string} name - search, account, cart, arrow, or check.
{% enddoc %}
<svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false">
  {% case name %}
    {% when 'search' %}<circle cx="10.5" cy="10.5" r="6.5"/><path d="m16 16 5 5"/>
    {% when 'account' %}<circle cx="12" cy="8" r="4"/><path d="M4 22v-2a8 8 0 0 1 16 0v2"/>
    {% when 'cart' %}<path d="M2 3h3l3 13h11l3-9H6M9 21h.01M19 21h.01"/>
    {% when 'arrow' %}<path d="M4 12h16m-6-6 6 6-6 6"/>
    {% else %}<path d="m5 12 4 4L19 6"/>
  {% endcase %}
</svg>
