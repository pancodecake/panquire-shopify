<section class="pq pq-hero" aria-label="{{ section.settings.label | escape }}" data-pq-carousel style="--pq-hero-ratio: {{ section.settings.aspect_ratio }};">
  <div class="pq-hero-track" data-pq-track>
    {% for block in section.blocks %}
      <div class="pq-hero-slide" id="Slide-{{ section.id }}-{{ forloop.index }}" data-pq-item {{ block.shopify_attributes }}>
        <div class="pq-hero-media">{% assign media_label = 'panquire.hero_image' | t %}{% render 'pq-media', image: block.settings.image, label: media_label, eager: forloop.first, sizes: '100vw' %}</div>
        <div class="pq-hero-copy pq-container" style="--pq-hero-text: {{ block.settings.text_color }};">
          {% if block.settings.kicker != blank %}<p class="pq-hero-kicker">{{ block.settings.kicker | escape }}</p>{% endif %}
          {% if forloop.first %}<h1>{{ block.settings.heading | escape }}</h1>{% else %}<h2>{{ block.settings.heading | escape }}</h2>{% endif %}
          <p>{{ block.settings.text | escape }}</p>
          {% if block.settings.link != blank and block.settings.button != blank %}<a class="pq-button pq-button--accent" href="{{ block.settings.link }}">{{ block.settings.button | escape }} {% render 'pq-icon', name: 'arrow' %}</a>{% endif %}
        </div>
      </div>
    {% endfor %}
  </div>
  {% if section.blocks.size > 1 %}<div class="pq-hero-controls" data-pq-controls hidden>{% for block in section.blocks %}<button type="button" class="pq-dot" data-pq-go="{{ forloop.index0 }}" aria-label="{{ 'panquire.slide' | t: number: forloop.index }}" aria-controls="Slide-{{ section.id }}-{{ forloop.index }}"{% if forloop.first %} aria-current="true"{% endif %}><span></span></button>{% endfor %}</div>{% endif %}
</section>
{% schema %}
{
  "name": "Panquire hero",
  "max_blocks": 5,
  "settings": [
    { "type": "text", "id": "label", "label": "Accessible section name", "default": "Featured collections" },
    { "type": "range", "id": "aspect_ratio", "label": "Desktop image ratio", "min": 1.5, "max": 3, "step": 0.1, "default": 2.2 }
  ],
  "blocks": [{ "type": "slide", "name": "Slide", "settings": [
    { "type": "image_picker", "id": "image", "label": "Hero image" },
    { "type": "text", "id": "kicker", "label": "Small heading", "default": "Introducing Panquire" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Go small. Ride big." },
    { "type": "text", "id": "text", "label": "Description", "default": "A new way to find your next ride." },
    { "type": "text", "id": "button", "label": "Button label", "default": "Explore products" },
    { "type": "url", "id": "link", "label": "Button link" },
    { "type": "color", "id": "text_color", "label": "Text color", "default": "#211f1e" }
  ] }],
  "presets": [{ "name": "Panquire hero", "blocks": [{ "type": "slide" }] }]
}
{% endschema %}
