<section class="pq pq-benefits">
  <div class="pq-container pq-benefit-grid">
    {% for block in section.blocks %}<div class="pq-benefit" {{ block.shopify_attributes }}><span class="pq-benefit-icon">{% render 'pq-icon', name: 'check' %}</span><div><h2>{{ block.settings.heading | escape }}</h2><p>{{ block.settings.text | escape }}</p></div></div>{% endfor %}
  </div>
</section>
{% schema %}
{
  "name": "Panquire service strip", "max_blocks": 4,
  "blocks": [{ "type": "benefit", "name": "Service item", "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "Delivery" },
    { "type": "text", "id": "text", "label": "Description", "default": "Delivery details coming soon." }
  ] }],
  "presets": [{ "name": "Panquire service strip", "blocks": [{"type":"benefit"},{"type":"benefit"},{"type":"benefit"},{"type":"benefit"}] }]
}
{% endschema %}
